{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridetracker.app/schemas/telemetry-frame-1.0.0.json",
  "title": "RideTracker Overlay Telemetry Frame",
  "type": "object",
  "required": ["timestampMs", "gForce", "speed", "heartRate", "vibration", "recording"],
  "properties": {
    "timestampMs": { "type": "number", "minimum": 0 },
    "gForce": {
      "type": "object",
      "required": ["lateral", "vertical", "longitudinal", "total"],
      "properties": {
        "lateral": { "type": "number" },
        "vertical": { "type": "number" },
        "longitudinal": { "type": "number" },
        "total": { "type": "number", "minimum": 0 }
      }
    },
    "speed": {
      "type": "object",
      "required": ["valueKmh", "source"],
      "properties": {
        "valueKmh": { "type": "number", "minimum": 0 },
        "source": { "enum": ["gps", "fused", "external"] },
        "accuracyKmh": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "heartRate": {
      "type": "object",
      "required": ["bpm", "source", "valid"],
      "properties": {
        "bpm": { "type": ["integer", "null"], "minimum": 0 },
        "source": { "enum": ["bluetooth", "watch", "manual", "none"] },
        "valid": { "type": "boolean" }
      }
    },
    "vibration": {
      "type": "object",
      "required": ["rmsMs2", "peakMs2", "level"],
      "properties": {
        "rmsMs2": { "type": "number", "minimum": 0 },
        "peakMs2": { "type": "number", "minimum": 0 },
        "level": { "enum": ["low", "medium", "high"] }
      }
    },
    "recording": {
      "type": "object",
      "required": ["active", "elapsedMs"],
      "properties": {
        "active": { "type": "boolean" },
        "elapsedMs": { "type": "number", "minimum": 0 }
      }
    },
    "compass": {
      "type": "object",
      "required": ["headingDeg", "source"],
      "properties": {
        "headingDeg": { "type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360 },
        "accuracyDeg": { "type": ["number", "null"], "minimum": 0 },
        "source": { "enum": ["device-orientation", "ios-compass", "gps-course", "unavailable"] }
      }
    }
  },
  "additionalProperties": true
}
